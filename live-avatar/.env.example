# Claude (or run `ant auth login` instead of setting a key)
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
# low = fastest replies; medium/high = more deliberate answers, slower to start talking
CLAUDE_EFFORT=low
ENABLE_WEB_SEARCH=true

# ElevenLabs text-to-speech (https://elevenlabs.io -> Profile -> API keys)
ELEVENLABS_API_KEY=
# Any voice ID from your ElevenLabs voice library; default is "George" (male, British)
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# eleven_turbo_v2_5 (fast, natural) | eleven_flash_v2_5 (fastest) | eleven_multilingual_v2 (richest)
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Avatar: any TalkingHead-compatible GLB (ARKit + Oculus viseme blend shapes).
# Default is the realistic Avatar SDK example model (non-commercial use only).
AVATAR_URL=https://cdn.jsdelivr.net/gh/met4citizen/TalkingHead@1.7/avatars/avatarsdk.glb
AVATAR_BODY=M
AVATAR_NAME=Claude
